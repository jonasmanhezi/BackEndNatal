# Porta (Railway/Render definem PORT automaticamente)
PORT=8080

# Postgres (Supabase pooler — use a connection string JDBC)
DATABASE_URL=jdbc:postgresql://HOST:6543/postgres?prepareThreshold=0
DATABASE_USERNAME=postgres.PROJECT_REF
DATABASE_PASSWORD=sua_senha

# Chave do organizador: entre uma vez por https://seu-site/#admin=ESTA_CHAVE
# Gere uma longa, por exemplo: openssl rand -hex 24
ADMIN_KEY=troque-por-uma-chave-longa

# CORS — domínio onde o frontend está publicado
# CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,https://seu-usuario.github.io
